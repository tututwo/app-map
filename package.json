{
  "name": "app-map",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "generate:data": "node scripts/prebuild-data.mjs",
    "predev": "npm run generate:data",
    "dev": "vite dev",
    "prebuild": "npm run generate:data",
    "build": "node --max-old-space-size=5120 node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "prepare": "husky && svelte-kit sync || echo ''",
    "precheck": "npm run generate:data",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "npm run test:unit && npm run test:contract",
    "pretest:unit": "npm run generate:data",
    "test:unit": "vitest run tests/unit",
    "pretest:contract": "npm run build",
    "test:contract": "playwright test tests/contract",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@rollup/plugin-dsv": "^3.0.5",
    "@sveltejs/adapter-vercel": "^5.7.2",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.6",
    "@types/d3": "^7.4.3",
    "@types/topojson-client": "^3.1.5",
    "bits-ui": "^2.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.6",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.0.0",
    "vite": "^6.2.6",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@deck.gl/core": "9.3.7",
    "@deck.gl/layers": "9.3.7",
    "@deck.gl/mapbox": "9.3.7",
    "@svelte-maplibre-gl/deckgl": "2.0.2",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "gsap": "^3.13.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^3.0.1",
    "jszip": "^3.10.1",
    "lucide-svelte": "^0.509.0",
    "maplibre-gl": "5.19.0",
    "runed": "^0.28.0",
    "shareon": "^2.6.0",
    "svelte-maplibre-gl": "2.2.0",
    "tailwind-merge": "^3.3.0",
    "topojson-client": "^3.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.6.1",
    "lightningcss-linux-x64-gnu": "^1.24.1"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
