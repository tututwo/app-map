{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.nvm/versions/node/v22.18.0/bin:$PATH\" && npx vite dev --port 5173 --strictPort"
      ],
      "port": 5173
    },
    {
      "name": "dev-local-tiles",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.nvm/versions/node/v22.18.0/bin:$PATH\" && PUBLIC_TILES_URL=/tiles npx vite dev --port 5183 --strictPort"
      ],
      "port": 5183
    },
    {
      "name": "worker-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.nvm/versions/node/v22.18.0/bin:$PATH\" && npm run preview:worker -- --port 8787 --local"
      ],
      "port": 8787
    }
  ]
