{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "church-closing-dashboard",
  "account_id": "54760a717e09de12d9b3d07808a05c4c",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
  },
  "vars": {
    "PUBLIC_TILES_URL": "/map-assets",
  },
  "r2_buckets": [
    {
      "binding": "TILES",
      "bucket_name": "worship-closures-tiles",
      "remote": true,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
